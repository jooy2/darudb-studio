{
  "name": "darudb-studio",
  "productName": "DaruDB Studio",
  "appId": "com.cdget.darudb-studio",
  "version": "0.1.0",
  "description": "A desktop app to open, browse and edit DaruDB database files.",
  "homepage": "https://github.com/jooy2/darudb-studio",
  "author": "CDGet <jooy2.contact@gmail.com>",
  "license": "MIT",
  "main": "dist/main/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jooy2/darudb-studio.git"
  },
  "bugs": {
    "url": "https://github.com/jooy2/darudb-studio/issues"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://localhost:5173"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite -d",
    "dev:debug:force": "vite -d --force",
    "build": "npm run build:pre && electron-builder --config=buildAssets/builder/config.ts",
    "build:pre": "tsc -b && vite build && node buildAssets/notices/write.mjs",
    "build:all": "npm run build:pre && electron-builder -wml --config=buildAssets/builder/config.ts",
    "build:dir": "npm run build:pre && electron-builder --dir --config=buildAssets/builder/config.ts",
    "build:win": "npm run build:pre && electron-builder --windows --config=buildAssets/builder/config.ts",
    "build:win:portable": "npm run build:pre && electron-builder --windows portable:x64 --config=buildAssets/builder/config.ts",
    "build:mac": "npm run build:pre && electron-builder --mac --config=buildAssets/builder/config.ts",
    "build:linux": "npm run build:pre && electron-builder --linux --config=buildAssets/builder/config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "npm run build:pre && playwright test",
    "test:linux": "npm run build:pre && xvfb-run --auto-servernum --server-args='-screen 0, 1280x960x24' -- playwright test"
  },
  "dependencies": {
    "darudb": "^1.5.0"
  },
  "devDependencies": {
    "@electron/devtron": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@reduxjs/toolkit": "^2.14.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "dotenv": "^18.0.10",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-extension-installer": "^2.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "i18next": "^27.0.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "jiti": "^2.7.0",
    "lucide-react": "^1.70.0",
    "plass-ui": "^1.9.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0"
  }
}
